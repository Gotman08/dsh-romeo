#!/usr/bin/env bash
# Fake squeue: understands -n NAME; prints "id state elapsed left reason".
name=''
while [ $# -gt 0 ]; do case $1 in -n) name=$2; shift 2 ;; *) shift ;; esac; done
[ -f "$FAKE_ROMEO_STATE/jobs" ] || exit 0
while read -r id fiche _; do
  [ -z "$name" ] || [ "$name" = "romeollmtool-$fiche" ] && echo "$id RUNNING 0:42 7:59:18 None"
done <"$FAKE_ROMEO_STATE/jobs"
